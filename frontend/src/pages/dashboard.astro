---
import Layout from '../layouts/Layout.astro';
import DashboardCharts from '../components/DashboardCharts';
---

<Layout title="Dashboard">
  <div class="min-h-screen" style="background-color: #1a1a2e; color: #f5f5f5;">
    <nav style="border-bottom: 3px solid #e94560; padding: 16px 32px; display: flex; justify-content: space-between; align-items: center;">
      <a href="/" style="font-weight: 700; font-size: 1.5rem; text-transform: uppercase; letter-spacing: -0.02em; color: #f5f5f5; text-decoration: none;">
        CHAMBERWORK<span style="color: #e94560;">.</span>SPACE
      </a>
      <div style="display: flex; gap: 16px; align-items: center;">
        <a href="/" style="color: #f5f5f5; text-decoration: none; font-weight: 700; text-transform: uppercase; font-size: 0.875rem;">Home</a>
        <a href="/settings" style="color: #f5f5f5; text-decoration: none; font-weight: 700; text-transform: uppercase; font-size: 0.875rem;">Settings</a>
        <button style="padding: 8px 24px; background: #e94560; color: #1a1a2e; border: 2px solid #e94560; font-weight: 700; text-transform: uppercase;">Sign In</button>
      </div>
    </nav>

    <div style="padding: 32px; max-width: 1200px; margin: 0 auto;">
      <h1 style="font-size: 2rem; font-weight: 700; text-transform: uppercase; margin-bottom: 32px; letter-spacing: -0.02em;">
        Active Workspaces
      </h1>

      <!-- Astro Island: React component with Recharts -->
      <DashboardCharts client:load />

      <!-- Workspace Table -->
      <div style="margin-top: 32px;">
        <h2 style="font-size: 1.25rem; font-weight: 700; text-transform: uppercase; margin-bottom: 16px; color: #00d2ff;">
          VPS Instances
        </h2>
        <table class="brutal-table" style="border-collapse: collapse; width: 100%; border: 2px solid #2a2a4a;">
          <thead>
            <tr>
              <th style="border: 1px solid #2a2a4a; padding: 12px; text-align: left; background: #e94560; color: #1a1a2e; font-weight: 700; text-transform: uppercase;">Tenant</th>
              <th style="border: 1px solid #2a2a4a; padding: 12px; text-align: left; background: #e94560; color: #1a1a2e; font-weight: 700; text-transform: uppercase;">Tier</th>
              <th style="border: 1px solid #2a2a4a; padding: 12px; text-align: left; background: #e94560; color: #1a1a2e; font-weight: 700; text-transform: uppercase;">Members</th>
              <th style="border: 1px solid #2a2a4a; padding: 12px; text-align: left; background: #e94560; color: #1a1a2e; font-weight: 700; text-transform: uppercase;">Status</th>
              <th style="border: 1px solid #2a2a4a; padding: 12px; text-align: right; background: #e94560; color: #1a1a2e; font-weight: 700; text-transform: uppercase;">Action</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom: 1px solid #2a2a4a;">
              <td style="padding: 12px; font-weight: 600;">acme-corp</td>
              <td style="padding: 12px; color: #cbd5e1;">Team Pro (4GB)</td>
              <td style="padding: 12px; color: #cbd5e1;">4</td>
              <td style="padding: 12px;"><span style="display: inline-block; padding: 2px 8px; border: 2px solid #00d2ff; color: #00d2ff; font-size: 0.75rem; font-weight: 700; text-transform: uppercase;">Healthy</span></td>
              <td style="padding: 12px; text-align: right;">
                <a href="https://acme.chamberwork.space/pen" style="display: inline-block; padding: 4px 12px; border: 2px solid #38bdf8; color: #38bdf8; text-decoration: none; font-weight: 700; text-transform: uppercase; font-size: 0.75rem;">Open CDE</a>
              </td>
            </tr>
            <tr style="border-bottom: 1px solid #2a2a4a;">
              <td style="padding: 12px; font-weight: 600;">solo-dev-pen</td>
              <td style="padding: 12px; color: #cbd5e1;">Solo CDE (1GB)</td>
              <td style="padding: 12px; color: #cbd5e1;">1</td>
              <td style="padding: 12px;"><span style="display: inline-block; padding: 2px 8px; border: 2px solid #00d2ff; color: #00d2ff; font-size: 0.75rem; font-weight: 700; text-transform: uppercase;">Healthy</span></td>
              <td style="padding: 12px; text-align: right;">
                <a href="https://pen.chamberwork.space" style="display: inline-block; padding: 4px 12px; border: 2px solid #38bdf8; color: #38bdf8; text-decoration: none; font-weight: 700; text-transform: uppercase; font-size: 0.75rem;">Open CDE</a>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</Layout>
