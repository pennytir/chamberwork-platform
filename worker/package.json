{
  "name": "chamberwork-platform",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Chamberwork CDE platform: Better-Auth control plane + metered container rentals on Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev",
    "build:frontend": "cd ../frontend && npm run build",
    "deploy": "npm run build:frontend && wrangler deploy",
    "db:generate": "wrangler d1 execute chamberwork --local --file=./schema.sql",
    "db:migrate": "wrangler d1 migrations apply chamberwork"
  },
  "dependencies": {
    "@cloudflare/containers": "^1.0.0",
    "@openchamber/sdk": "2.7.2",
    "better-auth": "^1.1.0",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.0",
    "stripe": "^17.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20261101.0",
    "typescript": "^5.6.3",
    "wrangler": "^4.0.0"
  }
}
